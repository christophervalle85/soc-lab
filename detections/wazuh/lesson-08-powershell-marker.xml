<!--

  Purpose: validate the native Wazuh custom-rule workflow against a controlled
  PowerShell marker. This is a narrowly scoped lab validation rule, not a claim
  that every PowerShell execution is malicious.
-->
<group name="windows,sysmon,custom_detection,lesson8,">
  <rule id="100100" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">SOC-LAB-LESSON8-T1059-001</field>
    <description>Controlled Lesson 8 PowerShell validation marker detected on $(win.system.computer)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>powershell,execution,lesson8_validation,</group>
  </rule>
</group>
